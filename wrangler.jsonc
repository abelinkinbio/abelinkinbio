{
  // ─────────────────────────────────────────────────────────────
  // Wrangler configuration for Cloudflare Workers
  //
  // This tells Cloudflare Workers how to serve the site.
  // The "assets" section points to Astro's build output folder.
  // Static asset requests (HTML, CSS, JS, images) are served
  // for FREE — you don't pay per request.
  //
  // To deploy: npm run deploy (or: astro build && wrangler deploy)
  // To preview locally: wrangler dev
  // ─────────────────────────────────────────────────────────────

  "$schema": "node_modules/wrangler/config-schema.json",

  // This becomes your Worker name in the Cloudflare dashboard.
  "name": "abelinkinbio",

  // Compatibility date — locks Worker behavior to a specific date
  // so Cloudflare can ship improvements without breaking your site.
  "compatibility_date": "2026-10-06",

  // Static pages still come from Astro's ./dist.
  // Only /api/* runs the worker first; every other route stays an asset.
  "main": "worker/index.ts",

  "assets": {
    "directory": "./dist",
    // Unknown URLs are served from the nearest 404.html with status 404.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI has no local simulator. `wrangler dev` uses the live API
  // (needs `wrangler login`). `wrangler dev --local` skips remote bindings;
  // the ask handler then falls back to a deterministic place.
  "ai": {
    "binding": "AI"
  },

  // 12 recommendations per minute per IP. namespace_id is an account-unique
  // integer; change it if 847211 is already used by another binding.
  "ratelimits": [
    {
      "name": "RECOMMEND_LIMIT",
      "namespace_id": "847211",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },

  // Preview builds (`wrangler preview`) do not inherit top-level bindings.
  "previews": {
    "ai": {
      "binding": "AI"
    },
    "ratelimits": [
      {
        "name": "RECOMMEND_LIMIT",
        "namespace_id": "847211",
        "simple": {
          "limit": 12,
          "period": 60
        }
      }
    ]
  }
}
