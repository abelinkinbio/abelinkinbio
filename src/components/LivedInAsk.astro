---
// Ask bar for /livedin. The markup lives here so the place-card
// template in the page can change independently.
//
// While this renders, write the place catalog the worker bundles.
// It is not a public URL — tags stay out of the page HTML.
import { mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { cities } from '../cities';

const cityIds = new Set(cities.map((city) => city.id));
const reviews = await getCollection('livedin');
const catalog = reviews
  .filter((review) => !review.data.draft && cityIds.has(review.id.split('/')[0]))
  .map((review) => ({
    id: review.id.replace(/\.md$/, ''),
    name: review.data.title,
    emoji: review.data.emoji,
    category: review.data.category,
    tags: review.data.tags,
    city: review.id.split('/')[0],
    description: review.data.description,
    ...(review.data.googleMaps ? { googleMaps: review.data.googleMaps } : {}),
    ...(review.data.appleMaps ? { appleMaps: review.data.appleMaps } : {}),
  }))
  .sort((a, b) => a.id.localeCompare(b.id));

if (catalog.length === 0) {
  throw new Error('livedin catalog is empty');
}

const cacheDir = join(process.cwd(), '.cache');
mkdirSync(cacheDir, { recursive: true });
writeFileSync(join(cacheDir, 'livedin-catalog.json'), JSON.stringify(catalog));
---

<form class="ask-bar" id="livedin-ask">
  <div class="ask-inner">
    <span class="ask-kicker">ask</span>
    <div class="ask-result" hidden aria-live="polite"></div>
    <button class="ask-sample" type="button" data-sample>it's midnight and i want a quick bite on my way home to principe real</button>
    <div class="ask-row">
      <div class="ask-field">
        <span class="terminal-prompt" aria-hidden="true">&gt;</span>
        <label class="sr-only" for="livedin-mood">what are you in the mood for?</label>
        <input
          id="livedin-mood"
          class="ask-input"
          type="text"
          name="mood"
          maxlength="240"
          autocomplete="off"
          enterkeyhint="send"
          placeholder="it's midnight and i want a quick bite on my way home to principe real"
          value="it's midnight and i want a quick bite on my way home to principe real"
        />
      </div>
      <button class="btn" type="submit">ask</button>
      <button class="btn" type="button" data-surprise>surprise me</button>
    </div>
    <div class="ask-follow" hidden>
      <button class="ask-chip" type="button" data-adjust="closer">too far</button>
      <button class="ask-chip" type="button" data-adjust="other">something else</button>
    </div>
    <p class="ask-status" role="status"></p>
  </div>
</form>

<script>
  (function () {
    var form = document.getElementById('livedin-ask');
    if (!form) return;
    var SAMPLE = "it's midnight and i want a quick bite on my way home to principe real";
    var input = form.querySelector('.ask-input');
    var result = form.querySelector('.ask-result');
    var follow = form.querySelector('.ask-follow');
    var status = form.querySelector('.ask-status');
    var state = { mood: '', exclude: [], city: null };
    var inFlight = false;

    function setStatus(message, isError) {
      status.textContent = message || '';
      status.classList.toggle('is-error', !!isError);
    }

    function setBusy(busy) {
      inFlight = busy;
      form.setAttribute('aria-busy', busy ? 'true' : 'false');
      var buttons = form.querySelectorAll('button');
      for (var i = 0; i < buttons.length; i++) buttons[i].disabled = busy;
      if (busy) setStatus('picking…', false);
    }

    function fromPath() {
      if (!document.referrer) return null;
      try {
        var url = new URL(document.referrer);
        if (url.origin !== window.location.origin) return null;
        if (url.pathname.indexOf('..') !== -1) return null;
        if (!/^\/[A-Za-z0-9/_\-.]*$/.test(url.pathname)) return null;
        if (url.pathname.length > 200) return null;
        return url.pathname;
      } catch (err) {
        return null;
      }
    }

    function el(tag, className, text) {
      var node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    }

    function text(value) {
      return document.createTextNode(value);
    }

    function link(href, label) {
      var anchor = el('a', null, label);
      anchor.href = href;
      anchor.target = '_blank';
      anchor.rel = 'noopener noreferrer';
      return anchor;
    }

    function revealPlace(city, name) {
      var tab = document.querySelector('.city-tab[data-city="' + CSS.escape(city) + '"]');
      if (tab && !tab.classList.contains('active')) tab.click();
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      requestAnimationFrame(function () {
        var panel = document.querySelector('.city-panel[data-city="' + CSS.escape(city) + '"]');
        if (!panel) return;
        var all = panel.querySelector('.category-filter[data-category="all"]');
        if (all && !all.classList.contains('active')) all.click();
        var cards = panel.querySelectorAll('.review-card');
        for (var i = 0; i < cards.length; i++) {
          var title = cards[i].querySelector('.card-title');
          var label = title && title.textContent ? title.textContent.replace(/\s+/g, ' ').trim() : '';
          if (label === name || label.endsWith(' ' + name)) {
            cards[i].classList.remove('hidden');
            cards[i].style.scrollMarginTop = '5rem';
            cards[i].style.scrollMarginBottom = '10rem';
            cards[i].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
            return;
          }
        }
      });
    }

    function selectedCity() {
      var tab = document.querySelector('.city-tab.active');
      return tab ? tab.getAttribute('data-city') : null;
    }

    function renderPlace(place, reason) {
      var card = el('article', 'card ask-card');
      var title = link(place.mapsUrl, (place.emoji ? place.emoji + ' ' : '') + place.name);
      title.className = 'card-title';
      card.append(title);
      card.append(el('p', 'ask-reason', reason));

      var pageBtn = el('button', 'ask-textbtn', 'on this page');
      pageBtn.type = 'button';
      pageBtn.addEventListener('click', function () {
        revealPlace(place.city, place.name);
      });

      var meta = el('p', 'card-meta ask-meta');
      meta.append(pageBtn);
      meta.append(text(' · '));
      meta.append(link(place.mapsUrl, 'Google Maps'));
      meta.append(text(' · '));
      meta.append(link(place.appleMapsUrl, 'Apple Maps'));
      card.append(meta);

      result.replaceChildren(card);
      result.hidden = false;
      follow.hidden = false;
    }

    async function ask(kind) {
      if (inFlight) return;
      var follow = kind === 'closer' || kind === 'other';
      var mood = kind === 'sample' ? SAMPLE : follow ? state.mood : (kind === 'surprise' ? '' : input.value.trim());
      var exclude = follow ? state.exclude.slice() : [];
      if (!follow) state.city = selectedCity();
      var payload = {
        mood: mood,
        time: { hour: new Date().getHours(), weekday: new Date().getDay() },
        exclude: exclude,
        adjust: follow ? kind : null,
        city: state.city,
      };
      var from = fromPath();
      if (from) payload.from = from;

      setBusy(true);
      try {
        var response = await fetch('/api/livedin/recommend', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = null;
        try {
          data = await response.json();
        } catch (err) {
          setStatus('the asker sent something unreadable', true);
          return;
        }
        if (!response.ok || !data || !data.place) {
          setStatus(data && data.error ? data.error : 'the asker got stuck', true);
          return;
        }
        if (!follow) state.exclude = [];
        state.mood = mood;
        if (state.exclude.indexOf(data.place.id) === -1) state.exclude.push(data.place.id);
        renderPlace(data.place, data.reason || '');
        setStatus('', false);
      } catch (err) {
        setStatus("couldn't reach the asker", true);
      } finally {
        setBusy(false);
      }
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      ask('submit');
    });

    form.querySelector('[data-surprise]').addEventListener('click', function () {
      ask('surprise');
    });

    form.querySelector('[data-sample]').addEventListener('click', function () {
      input.value = SAMPLE;
      ask('sample');
    });

    var chips = form.querySelectorAll('[data-adjust]');
    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener('click', function (event) {
        ask(event.currentTarget.getAttribute('data-adjust'));
      });
    }

  })();
</script>

<style>
  .ask-bar {
    position: relative;
    margin: 0 0 var(--space-lg);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-md) var(--space-sm);
  }

  .ask-inner { position: relative; }

  .ask-kicker {
    position: absolute;
    top: -1.15rem;
    left: 0;
    background: var(--color-bg);
    padding: 0 var(--space-sm);
    font-family: var(--font-body);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .ask-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .ask-field {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 1 1 16rem;
    min-width: 0;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    padding: 0 var(--space-sm);
  }

  .ask-field:focus-within {
    border-color: var(--color-interactive);
  }

  .ask-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: var(--space-sm) 0;
  }

  .ask-input:focus { outline: none; }
  .ask-input::placeholder { color: var(--color-muted); }

  .ask-bar .btn {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.65rem;
    white-space: nowrap;
  }

  .ask-sample {
    display: block;
    width: 100%;
    margin: 0 0 var(--space-xs);
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--color-interactive);
  }

  .ask-sample:hover,
  .ask-sample:focus-visible {
    color: var(--color-text);
    text-decoration: underline;
  }

  .ask-bar button:disabled {
    opacity: 0.55;
    cursor: progress;
  }

  .ask-result { margin-bottom: var(--space-sm); }
  .ask-result[hidden],
  .ask-follow[hidden] { display: none; }

  .ask-card {
    transition: none;
    padding: var(--space-sm) var(--space-md);
  }

  .ask-card-top {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .ask-card-top .tag:first-of-type { margin-left: auto; }

  .ask-reason {
    margin: var(--space-xs) 0 0;
    font-size: 0.8rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .ask-desc {
    margin-top: var(--space-xs);
    margin-bottom: 0;
  }

  .ask-meta {
    margin-top: var(--space-sm);
    margin-bottom: 0;
  }

  .ask-textbtn {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--color-interactive);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    letter-spacing: 0.02em;
  }

  .ask-textbtn:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .ask-follow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .ask-chip {
    font-family: var(--font-body);
    font-size: 0.65rem;
    text-transform: lowercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }

  .ask-chip:hover,
  .ask-chip:focus-visible {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
  }

  .ask-status {
    min-height: 0;
    margin: var(--space-xs) 0 0;
    font-size: 0.65rem;
    color: var(--color-muted);
  }

  .ask-status:empty { display: none; }
  .ask-status.is-error { color: var(--color-text); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .ask-input { font-size: 16px; }
    .ask-row .btn { flex: 1 1 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-bar,
    .ask-bar * {
      transition: none !important;
      animation: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
