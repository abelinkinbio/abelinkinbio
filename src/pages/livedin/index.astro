---
// ─────────────────────────────────────────────────────────────
// Lived In — Tabbed City Guide
//
// A single page with three tabs: Lisbon (default), D.C., ATX.
// Each tab shows a Leaflet map, category filters, and review
// cards for that city.
//
// Cards and map popups show the place name and link to a maps
// search for that name plus city. Coordinates are only used to
// drop pins. No individual review sub-pages — the card is enough.
//
// How it works: All three cities' HTML is rendered at build time.
// Client-side JS toggles visibility and initializes Leaflet maps.
// Maps in hidden tabs get invalidateSize() called on tab switch
// because Leaflet can't measure a hidden container properly.
// ─────────────────────────────────────────────────────────────

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { cities } from '../../cities';

// ─── Fetch all reviews ──────────────────────────────────────
const allReviews = await getCollection('livedin');

// Organize reviews by city, sorted by date (newest first)
const reviewsByCity: Record<string, typeof allReviews> = {};
for (const city of cities) {
  reviewsByCity[city.id] = allReviews
    .filter(r => r.id.startsWith(city.id + '/') && !r.data.draft)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
}

// Get unique categories per city
const categoriesByCity: Record<string, string[]> = {};
for (const city of cities) {
  categoriesByCity[city.id] = [...new Set(reviewsByCity[city.id].map(r => r.data.category))].sort();
}

// ─── Place names & map links ────────────────────────────────
// Search labels are what we append so "Liberty" resolves in
// Lisbon rather than some other city. Coordinates never go in
// these URLs — they only position pins.
function mapSearchQuery(name: string, city: string): string {
  const match = cities.find((entry) => entry.id === city);
  return `${name}, ${match ? match.query : city}`;
}

function googleMapsSearchUrl(query: string): string {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
}

function appleMapsSearchUrl(query: string): string {
  return `https://maps.apple.com/?q=${encodeURIComponent(query)}`;
}

function osmSearchUrl(query: string): string {
  return `https://www.openstreetmap.org/search?query=${encodeURIComponent(query)}`;
}

function placeLinks(
  data: {
    title: string;
  },
  city: string,
) {
  const name = data.title;
  const query = mapSearchQuery(name, city);
  return {
    name,
    mapsUrl: googleMapsSearchUrl(query),
    appleMapsUrl: appleMapsSearchUrl(query),
    osmUrl: osmSearchUrl(query),
  };
}

// ─── Map data ───────────────────────────────────────────────
// City center coordinates & zoom levels
const cityDefaults = Object.fromEntries(cities.map((city) => [city.id, city.map]));

// Serialize pin data for each city (only reviews with coordinates).
// lat/lng stay on the pin for Leaflet marker placement and are
// not rendered in the popup.
const pinsByCity: Record<string, any[]> = {};
for (const city of cities) {
  pinsByCity[city.id] = reviewsByCity[city.id]
    .filter(r => r.data.coordinates)
    .map(r => {
      const place = placeLinks(r.data, city.id);
      return {
        lat: r.data.coordinates!.lat,
        lng: r.data.coordinates!.lng,
        name: place.name,
        emoji: r.data.emoji,
        description: r.data.description,
        category: r.data.category,
        mapsUrl: place.mapsUrl,
        appleMapsUrl: place.appleMapsUrl,
        osmUrl: place.osmUrl,
      };
    });
}
---

<BaseLayout title="City Guides" activeNav="livedin">

  <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- ─── Page Header ──────────────────────────────────────── -->
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-lg);">
    <h1>City Guides</h1>
  </div>

  <!-- ─── City Tabs ────────────────────────────────────────── -->
  <div class="city-tabs" style="display: flex; gap: 0; margin-bottom: var(--space-xl); border-bottom: 1px solid var(--color-grid);">
    {cities.map((city, i) => (
      <button
        class={`city-tab ${i === 0 ? 'active' : ''}`}
        data-city={city.id}
        type="button"
      >
        {city.name}
        <span class="tab-count">{reviewsByCity[city.id].length}</span>
      </button>
    ))}
  </div>

  <!-- ─── Tab Panels ───────────────────────────────────────── -->
  {cities.map((city, i) => {
    const reviews = reviewsByCity[city.id];
    const categories = categoriesByCity[city.id];

    return (
      <div
        class="city-panel"
        data-city={city.id}
        style={i !== 0 ? 'display: none;' : ''}
      >
        <!-- Map -->
        <div class="map-container panel" style="margin-bottom: var(--space-xl);">
          <span class="panel-label">map · {city.name.toLowerCase()}</span>
          <div id={`map-${city.id}`} style="width: 100%; height: 100%;"></div>
        </div>

        <!-- Category filter tags -->
        {categories.length > 1 && (
          <div style="margin-bottom: var(--space-lg); display: flex; gap: var(--space-xs); flex-wrap: wrap;">
            <button class="tag tag-blue category-filter active" data-city={city.id} data-category="all">
              all ({reviews.length})
            </button>
            {categories.map((cat: string) => (
              <button class="tag category-filter" data-city={city.id} data-category={cat}>
                {cat} ({reviews.filter((r: any) => r.data.category === cat).length})
              </button>
            ))}
          </div>
        )}

        <!-- Reviews grid -->
        <section class="panel">
          <span class="panel-label">spots</span>
          <div class="grid-2">
            {reviews.map((review: any) => {
              const place = placeLinks(review.data, city.id);
              return (
                <article
                  class="card review-card"
                  data-category={review.data.category}
                >
                  <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm);">
                    <a
                      class="card-title"
                      href={place.mapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >{review.data.emoji} {place.name}</a>
                    <span class="tag">{review.data.category}</span>
                  </div>
                  <p class="card-description" style="margin-top: var(--space-xs); margin-bottom: 0;">{review.data.description}</p>
                  <p class="card-meta" style="margin-bottom: 0; margin-top: var(--space-sm);">
                    <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>
                    <span aria-hidden="true"> · </span>
                    <a href={place.appleMapsUrl} target="_blank" rel="noopener noreferrer">Apple Maps</a>
                    <span aria-hidden="true"> · </span>
                    <a href={place.osmUrl} target="_blank" rel="noopener noreferrer">OpenStreetMap</a>
                  </p>
                </article>
              );
            })}
          </div>
        </section>
      </div>
    );
  })}

<!-- Leaflet JS -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- ─── Map + Tab + Filter Logic ─────────────────────────── -->
<script is:inline
  data-pins-by-city={JSON.stringify(pinsByCity)}
  data-city-defaults={JSON.stringify(cityDefaults)}
>
  (function() {
    var script = document.currentScript;
    var pinsByCity = JSON.parse(script.getAttribute('data-pins-by-city'));
    var cityDefaults = JSON.parse(script.getAttribute('data-city-defaults'));

    // ─── Map Setup ──────────────────────────────────────────
    // Store map instances so we can call invalidateSize on tab switch
    var maps = {};

    function makeIcon() {
      var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="34" viewBox="0 0 24 34">'
        + '<path d="M12 33 C12 33 1 19 1 12 C1 5.82 5.82 1 12 1 C18.18 1 23 5.82 23 12 C23 19 12 33 12 33Z" '
        + 'fill="#1A1A2E" stroke="#F5F0E8" stroke-width="1.5"/>'
        + '<circle cx="12" cy="11" r="4" fill="#F5F0E8"/>'
        + '</svg>';

      return L.divIcon({
        html: svg,
        className: 'blueprint-pin',
        iconSize: [24, 34],
        iconAnchor: [12, 34],
        popupAnchor: [0, -30],
      });
    }

    function initMap(city) {
      var el = document.getElementById('map-' + city);
      if (!el || maps[city]) return;

      var center = cityDefaults[city] || { lat: 0, lng: 0, zoom: 12 };
      var pins = pinsByCity[city] || [];

      var map = L.map('map-' + city, {
        center: [center.lat, center.lng],
        zoom: center.zoom,
        zoomControl: false,
        attributionControl: false,
      });

      L.control.zoom({ position: 'bottomright' }).addTo(map);
      L.control.attribution({
        position: 'bottomleft',
        prefix: false
      }).addTo(map);

      // Standard OSM tiles. No API key. keepBuffer 0 and idle-only
      // updates avoid prefetching tiles outside the current view
      // (OpenStreetMap tile usage policy). One city map at a time.
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
        keepBuffer: 0,
        updateWhenIdle: true,
        updateWhenZooming: false,
      }).addTo(map);

      function esc(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function linkHtml(href, label) {
        if (!href) return '';
        return '<a class="map-popup-link" href="' + esc(href) + '" target="_blank" rel="noopener noreferrer">' + esc(label) + '</a>';
      }

      var markers = [];
      pins.forEach(function(pin) {
        var popupHtml = '<div class="map-popup">'
          + '<strong class="map-popup-title">' + esc(pin.emoji) + ' ' + esc(pin.name) + '</strong>'
          + '<span class="map-popup-cat">' + esc(pin.category) + '</span>'
          + '<p class="map-popup-desc">' + esc(pin.description) + '</p>'
          + '<div class="map-popup-links">'
          + linkHtml(pin.mapsUrl, 'Google Maps')
          + linkHtml(pin.appleMapsUrl, 'Apple Maps')
          + linkHtml(pin.osmUrl, 'OpenStreetMap')
          + '</div>'
          + '</div>';

        var marker = L.marker([pin.lat, pin.lng], { icon: makeIcon() })
          .bindPopup(popupHtml, { maxWidth: 240, className: 'blueprint-popup' })
          .addTo(map);

        markers.push(marker);
      });

      if (markers.length > 0) {
        var group = L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.02), { maxZoom: 15 });
        // Enforce a minimum zoom so cities with spread-out pins
        // (ATX, DC) don't pull back to a regional highway view.
        if (map.getZoom() < 13) {
          map.setZoom(13);
        }
      }

      maps[city] = map;
    }

    // Initialize the first (visible) map immediately
    initMap(document.querySelector('.city-tab').getAttribute('data-city'));

    // ─── Tab Switching ──────────────────────────────────────
    var tabs = document.querySelectorAll('.city-tab');
    var panels = document.querySelectorAll('.city-panel');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var city = tab.getAttribute('data-city');

        // Update active tab
        tabs.forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');

        // Show matching panel, hide others
        panels.forEach(function(panel) {
          panel.style.display = panel.getAttribute('data-city') === city ? '' : 'none';
        });

        // Initialize map if first visit, then fix rendering.
        // requestAnimationFrame ensures the panel is fully visible
        // and laid out before Leaflet tries to measure the container.
        requestAnimationFrame(function() {
          initMap(city);
          if (maps[city]) {
            maps[city].invalidateSize();
            // Second call catches any remaining tile offset
            setTimeout(function() {
              maps[city].invalidateSize();
            }, 200);
          }
        });
      });
    });

    // ─── Category Filtering ─────────────────────────────────
    document.querySelectorAll('.category-filter').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var city = btn.getAttribute('data-city');
        var category = btn.getAttribute('data-category');

        // Update active filter
        document.querySelectorAll('.category-filter[data-city="' + city + '"]').forEach(function(b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');

        // Filter cards
        var panel = document.querySelector('.city-panel[data-city="' + city + '"]');
        if (!panel) return;

        panel.querySelectorAll('.review-card').forEach(function(card) {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>

<!-- ─── Styles ─────────────────────────────────────────────── -->
<style>
  .city-tab {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-sm) var(--space-lg);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .city-tab:hover { color: var(--color-text); }
  .city-tab.active {
    color: var(--color-interactive);
    border-bottom-color: var(--color-interactive);
  }
  .tab-count {
    font-size: 0.6rem;
    opacity: 0.6;
  }

  .category-filter {
    cursor: pointer;
    background: none;
    border: 1px solid var(--color-grid);
    font-family: var(--font-body);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .category-filter:hover {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
  }
  .category-filter.active {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
  }

  .map-container {
    overflow: hidden;
    position: relative;
    margin-top: 1rem;
  }
  .map-container .panel-label {
    z-index: 2;
  }

  .review-card { transition: opacity var(--transition-fast); }
  .review-card.hidden { display: none; }
</style>

<!-- ─── Leaflet Blueprint Overrides (global) ──────────────── -->
<style is:global>
  #map-lisbon, #map-dc, #map-atx {
    background: var(--color-bg);
    z-index: 1;
  }

  .blueprint-pin {
    background: none !important;
    border: none !important;
  }

  .blueprint-popup .leaflet-popup-content-wrapper {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: 2px 2px 0 var(--color-grid-subtle);
    font-family: var(--font-body);
  }

  .blueprint-popup .leaflet-popup-tip {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: none;
  }

  .blueprint-popup .leaflet-popup-close-button {
    color: var(--color-muted);
    font-size: 16px;
    padding: var(--space-xs);
  }
  .blueprint-popup .leaflet-popup-close-button:hover { color: var(--color-text); }

  .map-popup { padding: 2px 0; }
  .map-popup-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-text);
    display: block;
    line-height: 1.3;
  }
  .map-popup-cat {
    font-family: var(--font-body);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    display: inline-block;
    border: 1px solid var(--color-border);
    padding: 1px 5px;
    margin-top: var(--space-xs);
  }
  .map-popup-desc {
    font-size: 0.7rem;
    color: var(--color-muted);
    margin: var(--space-sm) 0;
    line-height: 1.5;
  }
  .map-popup-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
  }
  .map-popup-link {
    font-family: var(--font-body);
    font-size: 0.65rem;
    color: var(--color-interactive);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .map-popup-link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .leaflet-control-zoom a {
    background: var(--color-bg) !important;
    border: 1px solid var(--color-border) !important;
    color: var(--color-text) !important;
    font-family: var(--font-body) !important;
    font-size: 14px !important;
    width: 28px !important;
    height: 28px !important;
    line-height: 28px !important;
    border-radius: 0 !important;
  }
  .leaflet-control-zoom a:hover { background: var(--color-bg-alt) !important; }
  .leaflet-control-zoom { border: none !important; box-shadow: none !important; }
  .leaflet-control-zoom-in { border-bottom: none !important; }
  .leaflet-control-attribution {
    background: var(--color-bg) !important;
    font-family: var(--font-body) !important;
    font-size: 10px !important;
    line-height: 1.3 !important;
    color: var(--color-text) !important;
    max-width: 70%;
  }
  .leaflet-control-attribution a {
    color: var(--color-text) !important;
    text-decoration: underline;
  }
</style>

</BaseLayout>
